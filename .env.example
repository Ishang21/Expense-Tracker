# Server-only secrets. Never prefix database credentials with VITE_.
# Runtime: Neon connection pooling ON.
DATABASE_URL=postgresql://USER:PASSWORD@YOUR-ENDPOINT-pooler.REGION.aws.neon.tech/neondb?sslmode=require
# Schema migrations: same Neon endpoint/branch/database, pooling OFF.
# Neon CLI writes DATABASE_URL_UNPOOLED; that name is also accepted instead of DIRECT_DATABASE_URL.
DIRECT_DATABASE_URL=postgresql://USER:PASSWORD@YOUR-ENDPOINT.REGION.aws.neon.tech/neondb?sslmode=require
